# ==============================================================================
# job_hunt プロジェクト共通 環境変数設定ファイル (.env.example)
# ==============================================================================
#
# このリポジトリ直下の .env に設定を記述すると、以下の各ツールから自動的に参照されます:
#   - .agents/tools/pwdo (ブラウザ自律委譲ツール)
#   - .agents/tools/pwq  (playwright-cli コンテキスト節約ラッパー)
#
# 【探索仕様】
# 各ツールは「ツール直下の .env」→「親ディレクトリ」を順に探索し、
# 最初に見つかった .env を 1 つ読み込みます。
# したがって、このリポジトリルートに .env を置けば、ツール配下ごとに .env を複製する必要がありません。
# （ツール直下に個別の .env を置いた場合は、そのツールの設定が優先されます）
#
# 【セットアップ方法】
# 1. このファイルをコピーしてリポジトリルートに .env を作成:
#    cp .env.example .env
# 2. OPENROUTER_API_KEY に API キーを入力
# 3. 解決確認:
#    node .agents/tools/pwdo/dist/cli.js models
#    node .agents/tools/pwq/dist/cli.js models
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenRouter API キー
# ------------------------------------------------------------------------------
# pwdo では必須（操作ループで LLM を使用するため）。
# pwq では任意（ask, summarize などの LLM 連携時のみ使用。通常操作は LLM 不要）。
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# [任意] OpenRouter API エンドポイント
# ------------------------------------------------------------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# [任意] Playwright CLI セッション名 (既定: default)
# ------------------------------------------------------------------------------
# PLAYWRIGHT_CLI_SESSION=default
