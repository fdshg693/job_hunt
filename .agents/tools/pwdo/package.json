{
  "name": "pwdo",
  "version": "0.1.0",
  "description": "Delegate a stretch of browser work to a cheap model: drives playwright-cli in a tool loop and returns only a short report",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "pwdo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.99",
    "zod": "^4.6.5"
  }
}
