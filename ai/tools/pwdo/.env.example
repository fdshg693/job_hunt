# ==============================================================================
# pwdo 環境変数設定ファイル (.env.example)
# ==============================================================================
#
# 【設定可能場所（優先度順）】
# 1. ai/tools/pwdo/.env  (pwdo 専用の個別設定)
# 2. リポジトリルートの .env (C:\C\job_hunt\.env) (pwq や他スクリプトと共通利用・推奨)
#
# ※ pwdo は実行時に「ツール直下の .env」から「親ディレクトリ (ai/tools/.env -> ai/.env -> リポジトリルートの .env)」
#    を順に探索し、最初に見つかった .env を読み込みます。
#    そのため、リポジトリルートに .env を 1 つ置いておけば pwdo と pwq で鍵を共有できます。
#
# 【セットアップ方法】
# 1. このファイルをコピーして .env を作成:
#    cp .env.example .env
#    （またはリポジトリルートに .env を作成）
# 2. OPENROUTER_API_KEY に取得した API キーを設定
# 3. 解決確認コマンド:
#    node dist/cli.js models
#    （または PATH が通っていれば: pwdo models）
# ==============================================================================

# ------------------------------------------------------------------------------
# [必須] OpenRouter API キー
# ------------------------------------------------------------------------------
# pwdo はブラウザ自律操作に LLM を使用するため必須です（設定がないと do コマンド実行時にエラー終了します）。
# https://openrouter.ai/keys から取得してください。
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# [任意] OpenRouter API エンドポイント
# ------------------------------------------------------------------------------
# プロキシや互換 API エンドポイントを経由する場合のみ指定してください。
# 未指定時の既定値: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# [任意] Playwright CLI セッション名
# ------------------------------------------------------------------------------
# pwdo -s=<session> 引数を省略したときの既定セッション名。
# 通常はコマンド実行時に -s=<session> で明示的に指定することを推奨します。
# PLAYWRIGHT_CLI_SESSION=default

# ------------------------------------------------------------------------------
# [任意] コマンド実行パスのオーバーライド
# ------------------------------------------------------------------------------
# pwdo が内部で呼び出す pwq および playwright-cli のパスを明示的に指定したい場合に使用します。
# 未設定時は PATH 上または隣接ディレクトリ (ai/tools/pwq) から自動検出されます。
# PWDO_PWQ=
# PWDO_PLAYWRIGHT_CLI=
